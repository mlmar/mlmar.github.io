---
const { title, description, uri, github, imgUri, imgPath, stack, compact = false } = Astro.props;
---

<article class={'project fade-item' + (compact ? ' compact' : '')}>
    <a class="img-wrapper" href={uri}>
        <img src={imgUri || imgPath} alt={title + ' screenshot'} loading="lazy" />
        <div class="img-overlay"></div>
    </a>
    <div class="description">
        <h3>
            <a class="project-title" href={uri} aria-label={`Visit ${title}`}>{title}</a>
            {github && (
                <a class="git-link" href={github} aria-label={`${title} on GitHub`}>
                    <img src="/icons/github.webp" alt="" aria-hidden="true" />
                </a>
            )}
        </h3>
        {!compact && description && <p class="desc-text">{description}</p>}
        <ul class={'stack-list' + (compact ? ' compact' : '')}>
            {stack.map((s: string) => (
                <li class="tag">{s}</li>
            ))}
        </ul>
    </div>
</article>

<style>
    .project {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .img-wrapper {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: var(--radius-md);
        aspect-ratio: 16 / 9;
        background: #f2f2f2;
    }

    .img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .img-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0);
        transition: background 0.3s ease;
    }

    .img-wrapper:hover img {
        transform: scale(1.03);
    }

    .img-wrapper:hover .img-overlay {
        background: rgba(0, 0, 0, 0.04);
    }

    .description {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
    }

    .project-title {
        transition: color var(--ease);
    }

    .project-title:hover {
        color: var(--color-secondary);
    }

    .git-link {
        display: flex;
        align-items: center;
        color: var(--color-subtle);
        transition: color var(--ease);
    }

    .git-link:hover {
        color: var(--color-primary);
    }

    .git-link img {
        width: 0.9rem;
        height: 0.9rem;
        object-fit: contain;
    }

    .desc-text {
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        line-height: 1.55;
        color: var(--color-muted);
    }

    .stack-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin-top: 0.1rem;
    }

    .tag {
        font-size: var(--text-sm);
        font-weight: var(--weight-regular);
        padding: 0.2rem 0.55rem;
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 100px;
        color: var(--color-muted);
        white-space: nowrap;
    }

    .compact .stack-list {
        display: none;
    }

    .project.compact .img-wrapper {
        aspect-ratio: 4 / 3;
    }

    .project.compact h3 {
        font-size: var(--text-sm);
    }
</style>