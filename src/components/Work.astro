---
import { getCollection } from 'astro:content';

const historyCollection = await getCollection('history');
---

<ul class='flex-col work-list'>
    {
        historyCollection.map(({ data }) => {
            return (
                <li class='flex-col fade-item'>
                    <h3>
                        {' '}
                        {data.start}&mdash;{data.end}{' '}
                    </h3>
                    <p> {data.title} </p>
                    {data.product && (
                        <p class='secondary'>
                            {' '}
                            {data.company} &mdash; {data.product}{' '}
                        </p>
                    )}
                    {!data.product && <p class='secondary'> {data.company} </p>}
                </li>
            );
        })
    }
</ul>

<style>
    ul.work-list {
        --dot-size: 0.6rem;
        --line-color: #d0d0d0;
        --list-gap: 3rem;

        list-style: none;
        gap: var(--list-gap);
    }

    ul.work-list li {
        gap: 0.3rem;
        font-weight: var(--weight-light);
        position: relative;
        padding-left: 1.75rem;
    }

    ul.work-list li::before {
        content: '';
        position: absolute;
        width: var(--dot-size);
        height: var(--dot-size);
        border-radius: 100%;
        background: var(--color-secondary);
        left: 0;
        top: 0.45rem;
    }

    ul.work-list li:not(:last-child)::after {
        content: '';
        position: absolute;
        width: 1px;
        height: calc(100% + var(--list-gap));
        left: calc(var(--dot-size) / 2 - 0.5px);
        top: calc(var(--dot-size) + 0.45rem);
        background: var(--line-color);
    }

    ul.work-list h3 {
        font-weight: var(--weight-medium);
        font-size: var(--text-sm);
    }

    ul.work-list p {
        font-size: var(--text-sm);
        line-height: 1.5;
    }

    ul.work-list p.secondary {
        color: var(--color-muted);
        font-size: var(--text-sm);
    }
</style>
