---
import { getCollection } from 'astro:content';

const historyCollection = await getCollection('history');
---

<ul class='flex-col work-list'>
    {
        historyCollection.map(({ data }) => {
            return (
                <li class='work-item fade-item'>
                    <div class='work-details flex-col'>
                        <h3> {data.title} </h3>
                        <p class='secondary'>
                            @ {data.company} {!!data.product && <Fragment> &mdash; {data.product}</Fragment>}{' '}
                        </p>
                    </div>
                    <p class='work-date'>
                        {data.start}&mdash;{data.end}
                    </p>
                </li>
            );
        })
    }
</ul>

<style>
    ul.work-list {
        --dot-size: 0.6rem;
        --line-color: #d0d0d0;
        --list-gap: 3rem;

        list-style: none;
        gap: var(--list-gap);
    }

    ul.work-list li.work-item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        font-weight: var(--weight-light);
        position: relative;
        column-gap: var(--spacing-md);
    }

    .work-details {
        gap: 0.3rem;
        flex: 1;
    }

    ul.work-list h3 {
        font-weight: var(--weight-medium);
        font-size: var(--text-sm);
    }

    ul.work-list p {
        font-size: var(--text-sm);
        line-height: 1.5;
    }

    ul.work-list p.secondary {
        color: var(--color-muted);
        font-size: var(--text-sm);
    }

    .work-date {
        color: var(--color-muted);
        grid-column: 3;
    }

    .work-img {
        height: fit-content;
        height: auto;
        width: 2.5rem;
        object-fit: contain;
    }

    @media (max-width: 30em) {
        ul.work-list li.work-item {
            grid-template-rows: auto 1fr;
            grid-template-columns: 1fr;
            row-gap: var(--spacing-xs);
        }

        .work-details {
            grid-row: 2;
        }

        .work-date {
            grid-row: 1;
            grid-column: 1;
        }
    }
</style>
