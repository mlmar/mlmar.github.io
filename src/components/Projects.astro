---
import projects from '../config/projects.json';
import Project from './Project.astro';

type ProjectProps = {
    title: string;
    description?: string;
    uri: string;
    github?: string;
    imgUri?: string;
    imgPath?: string;
    stack: string[];
    compact?: boolean;
};
---

<div class="projects-wrapper flex-col">
    <div class="projects-grid primary-grid">
        {projects.primary.map((project: ProjectProps) => <Project {...project}/>)}
    </div>

    <div class="secondary-section flex-col">
        <h3 class="sub-label">mini</h3>
        <div class="projects-grid secondary-grid">
            {projects.secondary.map((project: ProjectProps) => <Project {...project} compact/>)}
        </div>
    </div>

    <a class="repo-link" href={projects.portfolio.uri}>
        <img src="/icons/github.webp" alt="" aria-hidden="true" />
        <span>view portfolio source</span>
    </a>
</div>

<style>
    .projects-wrapper {
        gap: 3rem;
    }

    .projects-grid {
        display: grid;
        gap: 1.5rem;
    }

    .primary-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .secondary-section {
        gap: 0.75rem;
    }

    .sub-label {
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        letter-spacing: var(--tracking-md);
        color: var(--color-subtle);
        text-transform: lowercase;
    }

    .secondary-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .repo-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        color: var(--color-muted);
        transition: color var(--ease);
        width: fit-content;
    }

    .repo-link:hover {
        color: var(--color-secondary);
    }

    .repo-link img {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
    }

    @media (max-width: 43.75em) {
        .primary-grid {
            grid-template-columns: 1fr;
        }

        .secondary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>