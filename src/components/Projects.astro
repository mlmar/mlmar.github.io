---
import { getCollection } from 'astro:content';
import Project from './Project.astro';
import { getImage } from 'astro:assets';

const projectsCollection = await getCollection('projects');
const activeProjects = projectsCollection
    .filter((project) => project.data.active)
    .sort((a, b) => a.data.order - b.data.order);

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}');

const optimizedProjects = await Promise.all(
    activeProjects.map(async ({ data }) => {
        const imagePath = `../assets/projects/${data.image}`;
        const imageGetter = images[imagePath];
        if (!imageGetter) {
            throw new Error(`Image not found: ${imagePath}`);
        }
        const imageModule = await imageGetter();
        const optimizedImage = await getImage({
            src: imageModule.default,
            width: 661,
            format: 'webp',
        });
        return {
            ...data,
            image: optimizedImage.src,
        };
    }),
);
---

<div class='projects-wrapper flex-col'>
    <div class='projects-grid primary-grid'>
        {optimizedProjects.map((project) => <Project {...project} />)}
    </div>

    <a class='repo-link' href='https://github.com/mlmar/mlmar.github.io/tree/astro'>
        <img src='/icons/github.webp' alt='' aria-hidden='true' />
        <span>view portfolio source</span>
    </a>
</div>

<style>
    .projects-wrapper {
        gap: 3rem;
    }

    .projects-grid {
        display: grid;
        gap: 1.5rem;
    }

    .primary-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .repo-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        color: var(--color-muted);
        transition: color var(--ease);
        width: fit-content;
    }

    .repo-link:hover {
        color: var(--color-secondary);
    }

    .repo-link img {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
    }

    @media (max-width: 43.75em) {
        .primary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
