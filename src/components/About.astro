---
import about from '../config/about.json';
import { getImage } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.{png,jpg,jpeg,webp}');

const optimizedItems = await Promise.all(
    about.items.map(async (item) => {
        const imagePath = `../assets/icons/${item.icon}`;
        const imageGetter = images[imagePath];
        if (!imageGetter) {
            throw new Error(`Image not found: ${imagePath}`);
        }
        const imageModule = await imageGetter();
        return {
            ...item,
            icon: (await getImage({ src: imageModule.default, width: 16, height: 16, format: 'webp' })).src as string,
        };
    }),
);
---

<nav class='contact-links'>
    {
        optimizedItems.map((item) => (
            <a href={item.url} class='contact-item' aria-label={item.type}>
                <img src={item.icon} alt='' aria-hidden='true' />
                <span>{item.label}</span>
            </a>
        ))
    }
</nav>

<style>
    /* Contact row */
    .contact-links {
        display: flex;
        flex-direction: column;
        gap: 1rem 2rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        color: var(--color-subtle);
        transition: color var(--ease);
    }

    .contact-item:hover {
        color: var(--color-secondary);
    }

    .contact-item img {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
    }
</style>
