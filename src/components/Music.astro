---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Track from './Track.astro';
import type { ImageMetadata } from 'astro';

const tracks = await getCollection('music');

// Load all images from assets directory dynamically
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.{png,jpg,jpeg,webp}');

const optimizedTracks = await Promise.all(
    tracks.map(async (track) => {
        const imagePath = `../assets/covers/${track.data.image}`;
        const imageGetter = images[imagePath];
        if (!imageGetter) {
            throw new Error(`Image not found: ${imagePath}`);
        }
        const imageModule = await imageGetter();
        const optimizedImage = await getImage({
            src: imageModule.default,
            width: 400,
            height: 400,
            format: 'webp',
        });
        return {
            ...track,
            optimizedImageSrc: optimizedImage.src,
        };
    }),
);
---

<ul class='music-grid' aria-label='Music tracks'>
    {optimizedTracks.map(({ data, optimizedImageSrc }) => <Track data={data} optimizedImageSrc={optimizedImageSrc} />)}
</ul>

<style>
    ul.music-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    @media (max-width: 43.75em) {
        ul.music-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
