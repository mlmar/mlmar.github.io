---
import { getCollection } from 'astro:content';
import soundcloudIcon from '../assets/soundcloud.webp';

const tracks = await getCollection('music');
---

<ul class='music-grid' aria-label='Music tracks'>
    {
        tracks.map(({ data }) => (
            <li class='track-card fade-item' data-src={data.src} data-title={data.title}>
                <div class='track-header'>
                    <span class='track-title' aria-hidden='true'>
                        {data.title}
                    </span>
                    <a
                        href={data.url}
                        target='_blank'
                        rel='noopener noreferrer'
                        class='soundcloud-link'
                        aria-label={`Listen to ${data.title} on SoundCloud`}
                    >
                        <img src={soundcloudIcon.src} alt='SoundCloud logo' />
                    </a>
                </div>
                <div class='audio-container'>
                    <div class='audio-placeholder'>
                        <div class='audio-skeleton' />
                    </div>
                </div>
            </li>
        ))
    }
</ul>

<script>
    // Lazy-load audio elements via IntersectionObserver
    const cards = document.querySelectorAll<HTMLLIElement>('.track-card[data-src]');

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                const card = entry.target as HTMLLIElement;
                const src = card.dataset.src;
                const container = card.querySelector('.audio-container');
                if (!src || !container) return;

                const audio = document.createElement('audio');
                audio.src = `/music/${src}.webm`;
                audio.controls = true;
                audio.className = 'audio-player flex';
                audio.style.opacity = '0';
                audio.style.transition = 'opacity 0.4s ease';

                audio.addEventListener(
                    'canplay',
                    () => {
                        const placeholder = container.querySelector('.audio-placeholder');
                        if (placeholder) {
                            placeholder.remove();
                        }
                        requestAnimationFrame(() => {
                            audio.style.opacity = '1';
                        });
                    },
                    { once: true },
                );

                container.appendChild(audio);
                observer.unobserve(card);
            });
        },
        { threshold: 0.1, rootMargin: '100px' },
    );

    cards.forEach((card) => observer.observe(card));
</script>

<style>
    ul.music-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .track-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .track-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.25rem;
    }

    .track-title {
        font-size: var(--text-sm);
        font-weight: var(--weight-regular);
        letter-spacing: var(--tracking-sm);
        color: var(--color-subtle);
        text-transform: lowercase;
    }

    .soundcloud-link {
        display: flex;
        align-items: center;
        opacity: 0.6;
        transition:
            opacity var(--ease),
            transform var(--ease);
    }

    .soundcloud-link:hover {
        opacity: 1;
        transform: scale(1.05);
    }

    .soundcloud-link img {
        height: 1.1rem;
        width: auto;
        object-fit: contain;
    }

    .audio-container {
        width: 100%;
        position: relative;
    }

    .audio-placeholder {
        position: absolute;
        inset: 0;
        height: 100%;
        background: #f5f5f5;
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .audio-skeleton {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #f5f5f5 25%, #e8e8e8 50%, #f5f5f5 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
    }

    :global(.audio-player) {
        width: 100%;
        border-radius: var(--radius-md);
        display: flex;
        outline: none;
    }

    @keyframes shimmer {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }

    @media (max-width: 43.75em) {
        ul.music-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
