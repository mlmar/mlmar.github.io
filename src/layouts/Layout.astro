---
import '../pages/index.less';
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width' />
        <link rel='icon' type='image/svg+xml' href='/icons/m.ico' />
        <link rel='icon' href='/icons/m.ico' />
        <meta name='generator' content={Astro.generator} />
        <meta
            name='description'
            content='Marcus Martinez — Frontend Software Engineer. Portfolio featuring work history, projects, and music.'
        />
        <title>Marcus Martinez</title>
    </head>
    <body class='flex-col'>
        <a href='#main-content' class='skip-link sr-only'>Skip to main content</a>
        <main id='main-content' class='flex-col'>
            <slot />
        </main>
    </body></html
>

<style>
    .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        padding: 0.5rem 1rem;
        background: var(--color-secondary);
        color: #ffffff;
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        border-radius: var(--radius-sm);
        z-index: 100;
        transition: top var(--ease);
    }

    /* Reveal on focus for keyboard users */
    .skip-link:focus {
        top: 1rem;
    }

    main {
        padding: 3rem 6rem;
        flex: 1;
        max-width: 56.25rem;
        width: 100%;
        margin: 0 auto;
    }

    @media (max-width: 43.75em) {
        main {
            padding: var(--spacing-sm);
        }
    }
</style>
