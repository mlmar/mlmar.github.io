---
import '../pages/index.less';

const title = 'Marcus';
const description = 'Portfolio featuring projects and music.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width' />
        <link rel='icon' type='image/svg+xml' href='/icons/m.ico' />
        <link rel='icon' href='/icons/m.ico' />
        <meta name='generator' content={Astro.generator} />
        <meta name='description' content={description} />
        <title>{title}</title>
        <meta property='og:type' content='website' />
        <meta property='og:title' content={title} />
        <meta property='og:description' content={description} />
        <meta property='og:url' content={canonicalUrl} />
        <meta property='og:image' content={ogImageUrl} />
        <meta property='og:image:width' content='1200' />
        <meta property='og:image:height' content='630' />
        <meta name='twitter:card' content='summary' />
        <meta name='twitter:title' content={title} />
        <meta name='twitter:description' content={description} />
        <script defer src='https://cloud.umami.is/script.js' data-website-id='04747b00-9321-455a-9b75-fb902e15de59'></script>
    </head>
    <body class='flex-col'>
        <a href='#main-content' class='skip-link sr-only'>Skip to main content</a>
        <main id='main-content' class='flex-col'>
            <slot />
        </main>
    </body>
</html>

<style>
    .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        padding: 0.5rem 1rem;
        background: var(--color-secondary);
        color: #ffffff;
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        border-radius: var(--radius-sm);
        z-index: 100;
        transition: top var(--ease);
    }

    /* Reveal on focus for keyboard users */
    .skip-link:focus {
        top: 1rem;
    }

    main {
        padding: 3rem 6rem;
        flex: 1;
        max-width: 56.25rem;
        width: 100%;
        margin: 0 auto;
    }

    @media (max-width: 43.75em) {
        main {
            padding: var(--spacing-sm);
        }
    }
</style>
