---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Music from '../components/Music.astro';
---

<Layout>
    <!-- Hero -->
    <header class='hero fade-item'>
        <h1>
            hey i'm<br />Marcus
        </h1>
        <About />
    </header>

    <!-- Work History -->
    <section class='portfolio-section'>
        <h2 id='experience' class='section-label fade-item'>experience</h2>
        <Work />
    </section>

    <!-- Projects -->
    <section class='portfolio-section'>
        <h2 id='projects' class='section-label fade-item'>projects</h2>
        <Projects />
    </section>

    <!-- Creative / Music -->
    <section class='portfolio-section'>
        <h2 id='creative' class='section-label fade-item'>creative</h2>
        <Music />
    </section>
</Layout>

<script>
    import { initFadeIn } from '../scripts/fadeIn';
    initFadeIn();
</script>
