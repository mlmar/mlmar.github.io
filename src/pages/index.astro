---
import Layout from '../layouts/Layout.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Music from '../components/Music.astro';
import about from '../config/about.json';
---

<Layout>
    <!-- Hero -->
    <header class='hero fade-item'>
        <h1>hey i'm<br />Marcus</h1>
        <nav class='contact-links'>
            {
                about.items.map((item) => (
                    <a href={item.url} class='contact-item'>
                        <img src={item.icon} alt='' aria-hidden='true' />
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </nav>
    </header>

    <!-- Work History -->
    <section class='portfolio-section'>
        <h2 class='section-label fade-item'>work</h2>
        <Work />
    </section>

    <!-- Projects -->
    <section class='portfolio-section'>
        <h2 class='section-label fade-item'>projects</h2>
        <Projects />
    </section>

    <!-- Creative / Music -->
    <section class='portfolio-section'>
        <h2 class='section-label fade-item'>creative</h2>
        <Music />
    </section>
</Layout>

<script>
    // Intercept link clicks to prevent double-navigation
    document.addEventListener(
        'click',
        (event) => {
            const anchor = (event.target as HTMLElement).closest('a');
            if (anchor && anchor.href) {
                event.preventDefault();
                event.stopImmediatePropagation();
                window.location.href = anchor.href;
            }
        },
        { capture: true },
    );

    // Per-item IntersectionObserver — adds 'is-visible' with a small stagger
    // between items that enter the viewport in the same frame
    const items = document.querySelectorAll<HTMLElement>('.fade-item');

    // Hero fires immediately (already in viewport)
    const observer = new IntersectionObserver(
        (entries) => {
            // Group entries that are intersecting, stagger them
            const visible = entries.filter((e) => e.isIntersecting);
            visible.forEach((entry, i) => {
                const el = entry.target as HTMLElement;
                setTimeout(() => {
                    el.classList.add('is-visible');
                }, i * 80); // 80ms stagger between siblings entering together
                observer.unobserve(el);
            });
        },
        { threshold: 0.05, rootMargin: '0px 0px -40px 0px' },
    );

    items.forEach((el) => observer.observe(el));
</script>

<style>
    /* Hero */
    .hero {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: var(--section-gap);
    }

    h1 {
        font-size: clamp(3rem, 8vw, 5rem);
        line-height: 1;
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    /* Contact row */
    .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--text-sm);
        font-weight: var(--weight-light);
        color: var(--color-subtle);
        transition: color var(--ease);
    }

    .contact-item:hover {
        color: var(--text-secondary);
    }

    .contact-item img {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
    }

    /* Sections */
    .portfolio-section {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding-bottom: var(--section-gap);
    }

    .section-label {
        font-size: var(--text-sm);
        font-weight: var(--weight-regular);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    /* Prevent fade-item from resetting color after animation */
    .section-label.is-visible {
        color: var(--color-subtle);
    }

    @media (max-width: 43.75em) {
        .contact-links {
            gap: 0.75rem 1.25rem;
        }

        .contact-item span {
            display: none;
        }
    }
</style>
